# --- App ---
DATABASE_URL=sqlite:///./tenderbot.db
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/tenderbot
PUBLIC_BASE_URL=https://your-public-domain.example.com
ADMIN_API_KEY=change-this-long-random-secret

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VOICE_FROM=+1XXXXXXXXXX
# Optional: approved Content Template SID with YES/NO quick-reply buttons ({{1}}=tender title, {{2}}=amount)
TWILIO_APPROVAL_CONTENT_SID=
VALIDATE_TWILIO_SIGNATURE=true

# --- Login (Twilio Verify SMS OTP) ---
# Twilio Console -> Verify -> Services -> Create new -> copy the Service SID (starts with VA)
TWILIO_VERIFY_SERVICE_SID=
REQUIRE_AUTH=true
SESSION_DAYS=30

# --- Document uploads (encrypted at rest) ---
# Any long secret phrase. NEVER change or lose it, or stored files cannot be decrypted.
FILE_ENCRYPTION_SECRET=
MAX_UPLOAD_MB=5

# --- Business rules ---
TRIAL_DAYS=15
MIN_HISTORY_SAMPLES=3
EXPIRY_ALERT_DAYS=30
GST_RATE_PERCENT=18
ENABLE_SCHEDULER=true
VAULT_CHECK_INTERVAL_HOURS=24

# --- Optional integrations ---
# If set, an approved submission is POSTed here as JSON (your own DSC/portal submission service)
SUBMISSION_WEBHOOK_URL=
# Public portals the scraper is allowed to read (comma separated host suffixes)
ALLOWED_SCRAPE_HOSTS=mahatenders.gov.in,eprocure.gov.in,etenders.gov.in
