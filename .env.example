# --- App ---
DATABASE_URL=sqlite:///./tenderbot.db
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/tenderbot
PUBLIC_BASE_URL=https://your-public-domain.example.com
ADMIN_API_KEY=change-this-long-random-secret

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VOICE_FROM=+1XXXXXXXXXX
# Optional: approved Content Template SID with YES/NO quick-reply buttons ({{1}}=tender title, {{2}}=amount)
TWILIO_APPROVAL_CONTENT_SID=
VALIDATE_TWILIO_SIGNATURE=true

# --- Login (Twilio Verify SMS OTP) ---
# Twilio Console -> Verify -> Services -> Create new -> copy the Service SID (starts with VA)
TWILIO_VERIFY_SERVICE_SID=
REQUIRE_AUTH=true
SESSION_DAYS=30

# --- Document uploads (encrypted at rest) ---
# Any long secret phrase. NEVER change or lose it, or stored files cannot be decrypted.
FILE_ENCRYPTION_SECRET=
MAX_UPLOAD_MB=5

# --- Own OTP system (SMS via Fast2SMS OTP route; works without Twilio Verify) ---
# Recharge the Fast2SMS wallet (minimum Rs 100) and copy the key from Dev API. Indian +91 numbers only.
FAST2SMS_API_KEY=

# --- Daily marketing posts (poster + caption sent to your Telegram; auto-publish if the Meta values are set) ---
CONTENT_HOUR_IST=8
# true = one AI background picture per day (max 6, then reused). Uses your OpenAI credit (images cost more than text).
CONTENT_AI_BACKGROUND=false
OPENAI_IMAGE_MODEL=gpt-image-1
# Daily 9:16 video (about 20 s). Silent unless a Google Cloud Text-to-Speech key is set (Marathi voice-over).
CONTENT_VIDEO=false
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=mr-IN-Wavenet-A
GOOGLE_TTS_VOICE_EN=en-IN-Wavenet-A
# Which post languages also get a video (each video takes CPU time on a free server; use "mr" to save it)
CONTENT_VIDEO_LANGS=mr,en
# Facebook Page + linked Instagram professional account (Meta developer app, Page access token). Leave empty to only get posts on Telegram.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_BUSINESS_ID=
META_GRAPH_VERSION=v23.0

# --- Meta (Facebook/Instagram) one-time connection: create the app at developers.facebook.com, copy App ID and App secret ---
META_APP_ID=
META_APP_SECRET=

# --- AI avatar video (optional, paid; falls back to the built-in video if it fails) ---
VIDEO_PROVIDER=local
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID_MR=

# --- Lead capture (WhatsApp number shown on posters, videos and links) ---
LEAD_WHATSAPP_NUMBER=917028352281

# --- Android app (APK via pwabuilder.com) ---
# After PWABuilder creates the APK it shows the package id and a SHA-256 fingerprint. Put them here so the app opens full-screen (no browser bar).
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=

# --- Owner alerts (tender source down, new tenders, ...) ---
# Free option: Telegram bot (create with @BotFather). Or set ADMIN_WHATSAPP (+91...) to use WhatsApp via Twilio.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_WHATSAPP=

# --- Business rules ---
TRIAL_DAYS=15
MIN_HISTORY_SAMPLES=3
EXPIRY_ALERT_DAYS=30
GST_RATE_PERCENT=18
ENABLE_SCHEDULER=true
# Tender Hunter runs every N hours (needs the server awake; see README)
HUNTER_INTERVAL_HOURS=6
VAULT_CHECK_INTERVAL_HOURS=24

# --- Optional integrations ---
# If set, an approved submission is POSTed here as JSON (your own DSC/portal submission service)
SUBMISSION_WEBHOOK_URL=
# Public portals the scraper is allowed to read (comma separated host suffixes)
ALLOWED_SCRAPE_HOSTS=mahatenders.gov.in,eprocure.gov.in,etenders.gov.in
